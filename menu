import curses

def menu(stdscr):
    curses.curs_set(0)  # скрыть курсор
    curses.start_color()
    curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)  # чёрный на голубом
    curses.init_pair(2, curses.COLOR_WHITE, curses.COLOR_BLACK)  # белый на чёрном
    
    items = ["Играть", "Настройки", "Помощь", "Выход"]
    current = 0
    
    while True:
        stdscr.clear()
        
        # Заголовок
        stdscr.addstr(1, 5, "=== ГЛАВНОЕ МЕНЮ ===", curses.color_pair(1) | curses.A_BOLD)
        
        # Пункты
        for i, item in enumerate(items):
            if i == current:
                stdscr.addstr(3 + i, 5, f"> {item} <", curses.color_pair(1))
            else:
                stdscr.addstr(3 + i, 5, f"  {item}  ", curses.color_pair(2))
        
        stdscr.refresh()
        
        key = stdscr.getch()
        
        if key == curses.KEY_UP and current > 0:
            current -= 1
        elif key == curses.KEY_DOWN and current < len(items) - 1:
            current += 1
        elif key == 10:  # Enter
            break
    
    return current

# Запуск
choice = curses.wrapper(menu)
print(f"Ты выбрал: {choice}")

